# ─────────────────────────────────────────────────────────────
# Hit Tech — variables d'environnement
# Copiez ce fichier en `.env` puis renseignez vos propres valeurs.
# Ne commitez JAMAIS le fichier `.env`.
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/hittech"

# URL publique du site (sans slash final) — utilisée pour les canonical, le sitemap et Stripe
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Dossier de stockage des images téléversées (en dehors de /public)
UPLOAD_DIR="./storage/uploads"

# Compte administrateur créé par le seed (changez le mot de passe après la première connexion)
SEED_ADMIN_EMAIL="admin@hittech.ma"
SEED_ADMIN_PASSWORD="ChangezMoi!2026"

# ── Paiement Stripe (optionnel) ──
# Laissez vide pour désactiver le paiement par carte : seule l'option
# « paiement à la livraison » sera proposée si elle est activée dans l'admin.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── SEO & analytique (optionnel) ──
# Code de vérification Google Search Console (balise meta, valeur du champ content)
GOOGLE_SITE_VERIFICATION=""
# Analytique respectueuse de la vie privée (Plausible ou Umami auto-hébergé)
# Plausible : NEXT_PUBLIC_ANALYTICS_PROVIDER="plausible" + NEXT_PUBLIC_ANALYTICS_DOMAIN="hittech.ma"
# Umami     : NEXT_PUBLIC_ANALYTICS_PROVIDER="umami" + NEXT_PUBLIC_ANALYTICS_WEBSITE_ID="..." + NEXT_PUBLIC_ANALYTICS_SCRIPT_URL="https://umami.exemple.ma/script.js"
NEXT_PUBLIC_ANALYTICS_PROVIDER=""
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=""
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=""
