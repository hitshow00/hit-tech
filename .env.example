# ─────────────────────────────────────────────────────────────
# Hit Tech — Variables d'environnement pour la mise en production
# Copiez ce fichier en `.env` (en local) ou renseignez ces variables
# dans l'interface de votre hébergeur (ex. Vercel, Railway, Coolify).
# NE COMMITEZ JAMAIS DE FICHIER CONTENANT DES SECRETS EN PRODUCTION.
# ─────────────────────────────────────────────────────────────

# ── 1. Base de données PostgreSQL (Supabase / Neon / VPS) ──
# Chaîne de connexion PostgreSQL standard (sur Supabase, utilisez le port 6543 pooled pour le serverless)
DATABASE_URL="postgresql://postgres.votre_projet:votre_mot_de_passe@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── 2. URL Publique & Déploiement ──
# URL finale sans slash (ex. https://hittech.ma ou https://hit-tech.vercel.app)
NEXT_PUBLIC_SITE_URL="https://hit-tech.vercel.app"

# ── 3. Support Commercial & WhatsApp (Maroc) ──
# Numéro de téléphone WhatsApp officiel sans signe + (ex. 212612345678)
NEXT_PUBLIC_WHATSAPP_PHONE="212661234567"

# ── 4. Stockage des images produits ──
# Chemin local pour environnement serveur persistant (VPS / Docker)
UPLOAD_DIR="./storage/uploads"

# ── 5. Premier compte Administrateur (Généré par prisma db seed) ──
SEED_ADMIN_EMAIL="admin@hittech.ma"
SEED_ADMIN_PASSWORD="ChangezCeMotDePasseImmediatement2026!"

# ── 6. Paiement en ligne (Optionnel / Désactivé par défaut) ──
# Le site fonctionne en mode « Paiement Sécurisé à la Livraison » (COD) sur tout le Maroc.
# Les clés Stripe ou passerelle CMI seront à renseigner lors de la signature du contrat monétique.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── 7. Référencement SEO & Analytique (Optionnel) ──
GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_ANALYTICS_PROVIDER=""
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
