// Hit Tech — schéma de base de données
// Montants stockés en centimes (Int) pour éviter les erreurs d'arrondi.
// Devise par défaut : MAD (dirham marocain).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Utilisateurs & sessions ───────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions  Session[]
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  auditLogs AuditLog[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  postalCode String?
  country    String   @default("MA")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────── Catalogue ───────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    // court texte d'introduction (affiché en haut de page)
  content     String?    // guide d'achat / texte éditorial (bas de page)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  imageUrl    String?
  imageAlt    String?
  featured    Boolean    @default(false)
  position    Int        @default(0)
  isActive    Boolean    @default(true)

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
  @@index([featured, position])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)

  seoTitle       String?
  seoDescription String?

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  shortDescription String?
  description      String        // texte (paragraphes séparés par des lignes vides)
  specs            Json          @default("[]") // [{ "label": "Écran", "value": "6,1\"" }]
  price            Int           // prix de vente TTC en centimes MAD
  compareAtPrice   Int?          // ancien prix (promotion) en centimes
  currency         String        @default("MAD")
  stock            Int           @default(0)
  lowStockThreshold Int          @default(5)
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  isNew            Boolean       @default(false)
  salesCount       Int           @default(0)
  ratingAvg        Float         @default(0)
  ratingCount      Int           @default(0)
  weightGrams      Int?
  warrantyMonths   Int?
  gtin             String?       // EAN/UPC si disponible (données structurées)
  variantGroup     String?       // regroupe les versions d'un même modèle (ex. capacités)
  variantLabel     String?       // ex. "256 Go"

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  images     ProductImage[]
  reviews    Review[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, price])
  @@index([status, salesCount])
  @@index([status, createdAt])
  @@index([variantGroup])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  // grande taille (webp)
  mediumUrl String  // taille moyenne (fiche / cartes)
  thumbUrl  String  // miniature
  width     Int
  height    Int
  alt       String
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

// ─────────────────────────────── Avis ───────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  title            String
  body             String
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
}

// ─────────────────────────────── Panier ───────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  userId    String?
  items     CartItem[]
  discountCode String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, productId])
}

// ─────────────────────────────── Commandes ───────────────────────────────

enum OrderStatus {
  PENDING     // en attente (paiement en ligne non finalisé ou à confirmer)
  CONFIRMED   // confirmée
  PROCESSING  // en préparation
  SHIPPED     // expédiée
  DELIVERED   // livrée
  CANCELLED   // annulée
  RETURNED    // retournée / remboursée
}

enum PaymentMethod {
  COD     // paiement à la livraison
  STRIPE  // carte bancaire via Stripe
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  number        String        @unique
  accessTokenHash String      @unique // jeton (haché) pour consulter la commande sans compte
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)
  stripeSessionId String?     @unique
  currency      String        @default("MAD")

  subtotal      Int
  discountTotal Int           @default(0)
  shippingFee   Int
  total         Int
  discountCode  String?

  // Adresse de livraison (copie figée au moment de la commande)
  shipFullName   String
  shipPhone      String
  shipLine1      String
  shipLine2      String?
  shipCity       String
  shipPostalCode String?
  shipCountry    String  @default("MA")
  shippingCityId String?
  deliveryEstimate String?
  customerNote   String?
  trackingNumber String?
  carrier        String?

  items   OrderItem[]
  history OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  productSlug String
  sku         String
  imageUrl    String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdBy String?     // id de l'utilisateur (admin) ou null pour le système
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

// ─────────────────────────── Promotions & codes ───────────────────────────

enum DiscountType {
  PERCENT
  FIXED
}

model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType
  value       Int          // pourcentage (1-100) ou montant en centimes
  minSubtotal Int          @default(0)
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ─────────────────────────── Livraison & paramètres ───────────────────────────

model ShippingCity {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  region        String?
  fee           Int      // frais en centimes
  minDays       Int
  maxDays       Int
  codAvailable  Boolean  @default(true)
  isActive      Boolean  @default(true)
  // Page locale publiée uniquement si un contenu réel est renseigné
  hasLocalPage  Boolean  @default(false)
  localContent  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StoreSettings {
  id                    Int      @id @default(1)
  storeName             String   @default("Hit Tech")
  contactEmail          String
  contactPhone          String
  whatsapp              String?
  address               String
  city                  String
  openingHours          String?
  freeShippingThreshold Int?     // centimes ; null = pas de livraison gratuite
  codEnabled            Boolean  @default(true)
  codMaxAmount          Int?     // montant max autorisé pour le paiement à la livraison
  returnDays            Int      @default(7)
  updatedAt             DateTime @updatedAt
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  orderNumber String?
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isHandled, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // ex. product.update, order.status
  entityType String
  entityId   String?
  summary    String
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}
